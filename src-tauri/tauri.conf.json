{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameSaver",
  "version": "0.1.0",
  "identifier": "com.gamesaver.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameSaver",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
